generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Rsvp {
  id        String   @id @default(cuid())
  name      String
  guests    Int
  phone     String
  attending Boolean
  message   String?
  createdAt DateTime @default(now())
}
